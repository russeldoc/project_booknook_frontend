
# ---- MongoDB (same cluster/database as the backend) ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=booknook

# ---- BetterAuth ----
# Generate a secret:  npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public URL of THIS app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# ---- Google login (Google Cloud Console > APIs & Services > Credentials) ----
# Authorized redirect URI:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Express API (booknook-backend) ----
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---- imgbb image upload (https://api.imgbb.com/) ----
NEXT_PUBLIC_IMGBB_API_KEY=
